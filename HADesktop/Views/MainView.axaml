<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:HADesktop.ViewModels"
			 xmlns:l="clr-namespace:HADesktop.Localization"
			 xmlns:u="https://irihi.tech/ursa"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="HADesktop.Views.MainView"
			 x:DataType="vm:MainViewModel">
	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
		to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:MainViewModel />
	</Design.DataContext>
	<Panel>
		<Panel.Styles>
			<Style Selector="Panel.Blur">
				<Setter Property="Effect" Value="blur(10)" />
			</Style>
		</Panel.Styles>
		<u:OverlayDialogHost Name="Overlay" IsModalStatusReporter="True" ZIndex="100"/>
		<Panel Classes.Blur="{Binding #Overlay.(u:OverlayDialogHost.IsInModalStatus)}" IsEnabled="{Binding !#Overlay.(u:OverlayDialogHost.IsInModalStatus)}">
			<!--<u:OverlayDialogHost HostId="main" />-->
			<!--<TextBlock Text="{Binding Greeting}" HorizontalAlignment="Center" VerticalAlignment="Center"/>-->
			<Panel IsVisible="{Binding ShowOverview}" Margin="20">
				<Grid RowDefinitions="auto,auto,*">
					<TextBlock Text="{l:Loc MainView.Modules}" FontSize="18"/>

					<u:Banner Type="Warning" Grid.Row="1" IsVisible="{Binding IsConfigurationDirty}" Margin="0,10">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="{l:Loc MainView.SaveWarning}"/>
							<u:IconButton Margin="5,-5,-5,-5" Icon="💾" Padding="5" MinHeight="0" Height="28" FontSize="12" Content="{l:Loc MainView.SaveButton}" Theme="{DynamicResource SolidIconButton}" Command="{Binding SaveConfigurationCommand}"/>
						</StackPanel>
					</u:Banner>

					<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10">
						<ItemsControl ItemsSource="{Binding ActiveIntegrations}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<HeaderedContentControl Theme="{StaticResource GroupBox}" CornerRadius="20" Width="400" MinHeight="220">
										<HeaderedContentControl.Header>
											<DockPanel>
												<u:IconButton Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ConfigureIntegrationCommand}" CommandParameter="{Binding}" DockPanel.Dock="Right" Icon="⚙" Content="{l:Loc MainView.Configure}" Theme="{DynamicResource SolidIconButton}" Classes="Success" CornerRadius="16"/>
												<TextBlock VerticalAlignment="Center" Text="{Binding Registration.Name}" Classes="Header H6" Margin="0,0,20,0" TextWrapping="Wrap" />
											</DockPanel>
										</HeaderedContentControl.Header>
										<Grid RowDefinitions="*,auto" ColumnDefinitions="*,*">
											<TextBlock Text="{Binding Registration.Description}" TextWrapping="Wrap" Grid.ColumnSpan="2"/>
											<TextBlock Text="{l:Loc MainView.Enabled}" Grid.Row="1" HorizontalAlignment="Center"/>
											<ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding Enabled, Mode=OneWay}" HorizontalAlignment="Center" Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ToggleIntegrationCommand}" CommandParameter="{Binding}"/>
										</Grid>
									</HeaderedContentControl>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel ItemSpacing="10" LineSpacing="10" Orientation="Horizontal" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
				<Canvas>
					<u:IconButton Command="{Binding AddModuleCommand}" Canvas.Right="20" Canvas.Bottom="20" Icon="➕" Content="{l:Loc MainView.AddModule}" Theme="{DynamicResource SolidIconButton}" Classes="Large" CornerRadius="20"/>
				</Canvas>
			</Panel>
			<u:LoadingContainer IsLoading="{Binding SelectedIntegrationConfig.IsLoading}"
								LoadingMessage="{l:Loc MainView.Loading}"  IsVisible="{Binding ShowConfig}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
				<Panel Margin="20">
					<HeaderedContentControl Theme="{StaticResource GroupBox}">
						<HeaderedContentControl.Header>
							<DockPanel>
								<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
									<u:IconButton Command="{Binding ApplyModuleCommand}" IsVisible="{Binding SelectedIntegrationConfig.IsDirty}" Icon="⚙️" Content="{l:Loc MainView.Apply}" Theme="{DynamicResource SolidIconButton}" CornerRadius="16"/>
									<u:IconButton Command="{Binding DiscardModuleCommand}" IsVisible="{Binding SelectedIntegrationConfig.IsDirty}" Icon="↺" Content="{l:Loc MainView.Discard}" Theme="{DynamicResource SolidIconButton}" Classes="Warning" CornerRadius="16"/>
									<u:IconButton Command="{Binding ReturnModuleCommand}" Icon="←" Content="{l:Loc MainView.Back}" Theme="{DynamicResource SolidIconButton}" Classes="Success" CornerRadius="16"/>
									<u:IconButton Command="{Binding RemoveModuleCommand}" Icon="❌" Content="{l:Loc MainView.Remove}" Theme="{DynamicResource SolidIconButton}" Classes="Danger" CornerRadius="16"/>
								</StackPanel>
								<TextBlock Text="{Binding SelectedIntegrationConfig.Integration.Registration.Name}" Classes="Header H6" />
							</DockPanel>
						</HeaderedContentControl.Header>
						<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
							<ContentControl Content="{Binding SelectedIntegrationConfig}" />
						</ScrollViewer>
					</HeaderedContentControl>
				</Panel>
			</u:LoadingContainer>
		</Panel>
	</Panel>
</UserControl>
